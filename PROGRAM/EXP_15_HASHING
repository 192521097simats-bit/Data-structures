#include <stdio.h>

#define SIZE 10

int hashTable[SIZE];

void insert(int key) {
    int index=key%SIZE;

    while(hashTable[index]!=-1)
        index=(index+1)%SIZE;

    hashTable[index]=key;
}

int main() {
    int i;

    for(i=0;i<SIZE;i++)
        hashTable[i]=-1;

    insert(23);
    insert(43);
    insert(13);
    insert(27);

    printf("Hash Table:\n");

    for(i=0;i<SIZE;i++)
        printf("%d : %d\n",i,hashTable[i]);

    return 0;
}
OUTPUT:
Hash Table:
0 : -1
1 : -1
2 : -1
3 : 23
4 : 43
5 : 13
6 : -1
7 : 27
8 : -1
9 : -1
