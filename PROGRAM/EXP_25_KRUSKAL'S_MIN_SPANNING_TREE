#include <stdio.h>

struct edge {
    int u,v,w;
};

int parent[20];

int find(int x) {
    while(parent[x]!=x)
        x=parent[x];

    return x;
}

void unite(int a,int b) {
    a=find(a);
    b=find(b);
    parent[a]=b;
}

int main() {
    struct edge e[50],temp;
    int n,m,i,j,count=0,total=0;

    printf("Enter number of vertices: ");
    scanf("%d",&n);

    printf("Enter number of edges: ");
    scanf("%d",&m);

    printf("Enter edges (source destination weight):\n");

    for(i=0;i<m;i++)
        scanf("%d%d%d",&e[i].u,&e[i].v,&e[i].w);

    for(i=0;i<n;i++)
        parent[i]=i;

    /* Sort edges by weight */
    for(i=0;i<m-1;i++) {
        for(j=0;j<m-i-1;j++) {
            if(e[j].w>e[j+1].w) {
                temp=e[j];
                e[j]=e[j+1];
                e[j+1]=temp;
            }
        }
    }

    printf("Edges in MST:\n");

    for(i=0;i<m && count<n-1;i++) {
        if(find(e[i].u-1)!=find(e[i].v-1)) {
            printf("%d - %d : %d\n",
                   e[i].u,e[i].v,e[i].w);

            total+=e[i].w;
            unite(e[i].u-1,e[i].v-1);
            count++;
        }
    }

    printf("Minimum Cost = %d",total);

    return 0;
}
